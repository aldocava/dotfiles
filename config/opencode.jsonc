{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "<CONTEXT7_API_KEY>",
      },
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },
  },
}
